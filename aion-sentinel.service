[Unit]
Description=AION Sentinel Auto-Patch Agent
After=network-online.target kalshi-bot.service aion-guardian-report.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/kalshi-bot
EnvironmentFile=/opt/kalshi-bot/.env
ExecStart=/usr/bin/python3 /opt/kalshi-bot/aion_sentinel_agent.py --once
StandardOutput=journal
StandardError=journal

