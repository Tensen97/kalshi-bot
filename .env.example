# Live authorization
KALSHI_ALLOW_LIVE=false
LIVE_ENV_CONFIRMED=false
DRY_RUN_LIVE_ORDERS=true
KALSHI_LIVE_BASE_URL=https://api.elections.kalshi.com
KALSHI_API_KEY_ID=replace_me
LIVE_PRIVATE_KEY_PATH=/opt/kalshi-bot/keys/kalshi_live_key.pem

# Runtime
AION_RUNTIME_ROOT=/opt/kalshi-bot/runtime
AION_LIVE_ENGINE_STATE=/opt/kalshi-bot/runtime/state/aion_live_engine.json
AION_LOOP_SLEEP_SECONDS=5
AION_SCAN_LIMIT=200
AION_SCAN_PAGES=3
AION_MAX_HYDRATE_PER_CYCLE=80

# Entry scope
AION_MIN_SCORE_TO_SUBMIT=8
AION_MIN_CONFIDENCE_TO_SUBMIT=0.15
AION_MAX_ENTRY_SPREAD_HARD=0.55

# Sizing and capital routing
AION_BASE_ORDER_SIZE=1
AION_MAX_LIVE_ORDER_SIZE=3
AION_MAX_OPEN_POSITIONS=8
AION_MAX_DOLLARS_PER_TRADE=20
AION_MAX_SINGLE_POSITION_PCT=0.05
AION_BALANCE_CACHE_SECONDS=20

# Catastrophic risk
AION_MAX_DAILY_LOSS=50
LIVE_ORDER_RATE_LIMIT=5
LIVE_ORDER_RATE_WINDOW_SEC=60

# Exit management
AION_EXIT_TAKE_PROFIT=0.04
AION_EXIT_STOP_LOSS=0.04
AION_EXIT_TRAILING_START=0.03
AION_EXIT_TRAILING_DISTANCE=0.015
AION_EXIT_MAX_HOLD_SECONDS=900
