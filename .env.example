# Safety defaults
KALSHI_ALLOW_LIVE=false
LIVE_ARMED=false
LIVE_ENV_CONFIRMED=false
DRY_RUN_LIVE_ORDERS=true
AION_LIVE_ARB_ENABLED=0
AION_FAIR_VALUE_SHADOW=1
AION_CALIBRATION_MODE=0
AION_CALIBRATION_RELAXED_SHADOW=0
# Telemetry-first expectancy activation and bounded loosening controls.
AION_CONTROLLED_LOOSENING_ENABLED=1
# Allows a tiny Realm V.V fast-path when timing and expectancy line up.
AION_SENTINEL_AUTOPATCH=true
AION_SENTINEL_DRY_RUN=false
AION_SENTINEL_MAX_PATCHES_PER_HOUR=5
AION_SENTINEL_REQUIRE_COMPILE=true
AION_SENTINEL_REQUIRE_RESTART_VERIFY=true
AION_SENTINEL_AI_ENABLED=0
AION_SENTINEL_AI_SIMULATION=1
AION_SENTINEL_REQUIRE_HUMAN_CONFIRM=1
AION_SENTINEL_AI_MODEL=gpt-4.1
# Required only when AION_SENTINEL_AI_ENABLED=1
OPENAI_API_KEY=replace_me
AION_PHASE55_FASTPATH_ENABLED=1
# Allows a good-enough pullback instead of waiting for a perfect one.
AION_MICRO_PULLBACK_RELAX_ENABLED=1
# Allows family-level cooldown bypass only when other hard guards pass.
AION_COOLDOWN_SOFT_BYPASS_ENABLED=1
# Enables shadow tracking for near-pass / rejected opportunities.
AION_SHADOW_TRADE_TRACKING_ENABLED=1
# Enables expectancy scoring and soft ranking adjustments.
AION_EXPECTANCY_SCORE_ENABLED=1
# Enables lightweight public top-trader signal boosts. This is a ranking hint, not a gate.
AION_ELITE_SIGNAL_ENABLED=true
AION_ELITE_SIGNAL_MAX_AGE_HOURS=72
AION_ELITE_SIGNAL_SCORE_BOOST=0.04
AION_ELITE_SIGNAL_STRONG_BOOST=0.08
AION_ELITE_SIGNAL_MIN_MATCH_CONFIDENCE=0.78
AION_ELITE_SIGNAL_FILE=data/elite_public_signals.jsonl
AION_ELITE_SIGNAL_CSV_FILE=data/elite_public_signals.csv
# Caps the number of relaxation-assisted trades per day.
AION_MAX_RELAXATION_TRADES_PER_DAY=15
# Profit targets are guidance only and must never force negative expectancy trades.
AION_DAILY_PROFIT_TARGET=50
# Weekly guidance only. Never overrides safety or expectancy.
AION_WEEKLY_PROFIT_TARGET=250
# Monthly guidance only. Never overrides safety or expectancy.
AION_MONTHLY_PROFIT_TARGET=1000
# Adaptive guidance mode keeps the target layer advisory only.
AION_PROFIT_TARGET_MODE=adaptive_guidance
# Enables bounded opportunity expansion pressure when expectancy is favorable.
AION_PROFIT_EXPANSION_ENABLED=1
DEBUG_LIVE=false

# Runtime layout
AION_RUNTIME_ROOT=/opt/kalshi-bot/runtime

# Passive Obsidian export. This is best-effort only and never required for trading.
OBSIDIAN_EXPORT_ENABLED=1
OBSIDIAN_VAULT_PATH=/opt/kalshi-brain/obsidian-vault

# Telemetry-only sports combo research. This never submits combo orders.
COMBO_RESEARCH_ENABLED=true
COMBO_RESEARCH_SIM_STAKE=1
COMBO_RESEARCH_MAX_LEGS=4
COMBO_RESEARCH_MIN_CANDIDATES=2
AION_COMBO_POSITIVE_DISCOVERY_ENABLED=true
AION_COMBO_MIN_HISTORICAL_ROI=0.0
AION_COMBO_MIN_HISTORICAL_SAMPLE_SIZE=5000
AION_COMBO_MAX_LIVE_READY_LEGS=2
AION_COMBO_ALLOW_NEGATIVE_DIAGNOSTICS=true

# Sports calibration
AION_SPORTS_MIN_EDGE_AFTER_COST=0.001
AION_AGGRESSIVE_EDGE_FLOOR=0.0001
AION_SPORTS_WIDE_SPREAD_BUFFER=0.025
AION_SPORTS_MAX_SPREAD_SOFT=0.32
AION_SPORTS_MAX_SPREAD_HARD=0.35
AION_SPORTS_REQUIRE_DIRECTIONAL_BIAS=1
AION_SPORTS_MIN_MOMENTUM_FOR_WIDE=0.18
AION_WEAK_SPORTS_DEMOTE=2.0
AION_WEAK_SPORTS_SKIP_DEMOTE=5.0
AION_SPORTS_TRASH_PROP_PENALTY=3.7
AION_SPORTS_TRASH_PROP_SKIP_PENALTY=6.3
AION_SPORTS_MEMORY_MAX_RANK_PENALTY=0.30
AION_SPORTS_MEMORY_MIN_SIZE_MULTIPLIER=0.95

# Live sports concurrency
AION_MAX_OPEN_POSITIONS=8
AION_MAX_SPORTS_OPEN_POSITIONS=8
AION_MAX_SUBMITS_PER_CYCLE=5
AION_MAX_NEW_POSITIONS_PER_10MIN=12
AION_MIN_SECONDS_BETWEEN_SUBMITS=5
AION_MAX_SAME_FAMILY_POSITIONS=3
AION_MAX_SAME_GAME_POSITIONS=2
AION_LIVE_ORDER_RATE_LIMIT=5
LIVE_ORDER_RATE_LIMIT=5

# Account-aware live sizing discipline. This resizes only; it never submits or blocks orders.
AION_POSITION_SIZING_INTELLIGENCE_ENABLED=true
AION_MAX_SINGLE_POSITION_PCT=0.05
AION_ELITE_SINGLE_POSITION_PCT=0.10
AION_ELITE_SIZE_MIN_SCORE=85
AION_LONGSHOT_MAX_POSITION_PCT=0.01
AION_CONVICTION_SIZING_ENABLED=true
AION_CONVICTION_WEAK_MULTIPLIER=0.5
AION_CONVICTION_STRONG_MULTIPLIER=1.5
AION_CONVICTION_ELITE_MULTIPLIER=2.0
AION_CONVICTION_STRONG_CONFIDENCE=85

# Persistence / memory
SERAPH_MEMORY_SQLITE_PATH=/opt/kalshi-bot/data/seraph_memory.sqlite3
REALM_XXIX_STATE_FILE=/opt/kalshi-bot/data/realm_xxix_live_state.json
